# Copy to .env and fill in. Without a key the app runs with the offline demo brain.
ANTHROPIC_API_KEY=

# Optional
# claude-haiku-5-5 is fastest for voice; see "Choosing a model" in the README
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low
# auto = Claude if a key is set, otherwise offline. Or force: claude | offline
RECEPTIONIST_MODE=auto

# en | sl. Slovenian needs Claude (the offline brain is English-only).
RECEPTIONIST_LANGUAGE=en

# Empty = per-language default: small.en / large-v3-turbo, en-GB-SoniaNeural / sl-SI-PetraNeural
WHISPER_MODEL=
TTS_VOICE=
# auto tries CUDA first, then CPU
WHISPER_DEVICE=auto
DB_PATH=
