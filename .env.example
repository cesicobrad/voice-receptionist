# Copy to .env and fill in. Without a key the app runs with the offline demo brain.
ANTHROPIC_API_KEY=

# Optional
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# auto = Claude if a key is set, otherwise offline. Or force: claude | offline
RECEPTIONIST_MODE=auto

WHISPER_MODEL=small.en
# auto tries CUDA first, then CPU
WHISPER_DEVICE=auto
TTS_VOICE=en-GB-SoniaNeural
DB_PATH=
